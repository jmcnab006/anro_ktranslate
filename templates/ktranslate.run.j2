{{ anro_ktranslate_podman_binary }} run --rm --name {{ anro_ktranslate_instance.name }} --pull={{ anro_ktranslate_instance.pull_policy | default(anro_ktranslate_default_pull_policy) }} --network {{ anro_ktranslate_instance.network | default(anro_ktranslate_default_network) }} --env-file={{ anro_ktranslate_environment_dir }}/{{ anro_ktranslate_instance.name }}.env{% if (anro_ktranslate_instance.network | default(anro_ktranslate_default_network)) != 'host' %}{% for port in anro_ktranslate_instance.ports | default([]) %} --publish={{ port }}{% endfor %}{% endif %}{% if (anro_ktranslate_instance.discovery_output | default(false) | bool) or (anro_ktranslate_instance.runtime_output | default(false) | bool) %} --mount={{ ('type=bind,source=' ~ anro_ktranslate_current_config_dir ~ '/runtime,target=/etc/ktranslate/runtime') | to_json }}{% endif %}{% for file in anro_ktranslate_instance.files | default([]) %}{% if (file.source | default('managed')) in ['managed', 'url'] %}{% set mount_source = anro_ktranslate_current_config_dir ~ '/' ~ file.name %}{% else %}{% set mount_source = file.host_path %}{% endif %} --mount={{ ('type=bind,source=' ~ mount_source ~ ',target=' ~ file.destination ~ (',readonly' if (file.read_only | default(true) | bool) else '')) | to_json }}{% endfor %}{% for volume in anro_ktranslate_instance.volumes | default([]) %} --mount={{ ('type=bind,source=' ~ volume.source ~ ',target=' ~ volume.target ~ (',readonly' if (volume.read_only | default(false) | bool) else '')) | to_json }}{% endfor %}{% for capability in (anro_ktranslate_required_capabilities + (anro_ktranslate_instance.cap_add | default([]))) | unique %} --cap-add={{ capability }}{% endfor %}{% for podman_arg in anro_ktranslate_instance.extra_podman_args | default([]) %} {{ podman_arg | to_json }}{% endfor %} {{ (anro_ktranslate_instance.image | default(anro_ktranslate_image)) | to_json }}{% for command_arg in anro_ktranslate_instance.command | default(anro_ktranslate_default_command) %} {{ command_arg | to_json }}{% endfor %}
