# {{ anro_ktranslate_managed_marker }}
[Unit]
Description=ktranslate {{ anro_ktranslate_instance.service_type }} instance {{ anro_ktranslate_instance.name }}
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec={{ anro_ktranslate_instance.restart_sec | default(anro_ktranslate_default_restart_sec) }}
TimeoutStopSec={{ (anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) | int) + 10 }}

# A previous unclean shutdown can leave a stopped container with the same name.
# The leading '-' makes a missing container non-fatal and keeps startup idempotent.
ExecStartPre=-{{ anro_ktranslate_docker_binary }} rm --force {{ anro_ktranslate_current_service_name }}

ExecStart={{ anro_ktranslate_docker_binary }} run --name {{ anro_ktranslate_current_service_name }} --pull={{ anro_ktranslate_instance.pull_policy | default(anro_ktranslate_default_pull_policy) }} --network {{ anro_ktranslate_instance.network | default(anro_ktranslate_default_network) }} --env-file {{ anro_ktranslate_environment_dir }}/{{ anro_ktranslate_current_service_name }}.env --mount type=bind,source={{ anro_ktranslate_current_config_dir }}/config.yaml,target={{ anro_ktranslate_container_config_dir }}/config.yaml,readonly{% for port in anro_ktranslate_instance.ports | default([]) %} --publish {{ port }}{% endfor %}{% for volume in anro_ktranslate_instance.volumes | default([]) %} --mount type=bind,source={{ volume.source }},target={{ volume.target }}{% if volume.read_only | default(false) %},readonly{% endif %}{% endfor %}{% for capability in anro_ktranslate_instance.cap_add | default([]) %} --cap-add {{ capability }}{% endfor %}{% for docker_arg in anro_ktranslate_instance.extra_docker_args | default([]) %} {{ docker_arg }}{% endfor %} {{ anro_ktranslate_instance.image | default(anro_ktranslate_image) }}{% for command_arg in anro_ktranslate_instance.command | default([]) %} {{ command_arg | to_json }}{% endfor %}

ExecStop={{ anro_ktranslate_docker_binary }} stop --time {{ anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) }} {{ anro_ktranslate_current_service_name }}
ExecStopPost=-{{ anro_ktranslate_docker_binary }} rm --force {{ anro_ktranslate_current_service_name }}

[Install]
WantedBy=multi-user.target
