# {{ anro_ktranslate_managed_marker }}
# Instance type is descriptive metadata: {{ anro_ktranslate_instance.type }}
{% for external_stat in anro_ktranslate_external_file_stats.results | default([]) %}
{% if not (external_stat.skipped | default(false) | bool) %}
# External file checksum {{ external_stat.item.host_path }}: {{ external_stat.stat.checksum | default('unavailable') }}
{% endif %}
{% endfor %}
[Unit]
Description=ktranslate {{ anro_ktranslate_instance.type }} instance {{ anro_ktranslate_instance.name }}
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec={{ anro_ktranslate_instance.start_limit_interval_sec | default(anro_ktranslate_default_start_limit_interval_sec) }}
StartLimitBurst={{ anro_ktranslate_instance.start_limit_burst | default(anro_ktranslate_default_start_limit_burst) }}

[Service]
Type=simple
Restart=always
RestartSec={{ anro_ktranslate_instance.restart_sec | default(anro_ktranslate_default_restart_sec) }}
TimeoutStopSec={{ (anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) | int) + 10 }}

# A previous unclean shutdown can leave a stopped container with the same name.
# The leading '-' makes an already absent container non-fatal.
ExecStartPre=-{{ anro_ktranslate_docker_binary }} rm --force {{ anro_ktranslate_instance.name }}

ExecStart={{ anro_ktranslate_docker_binary }} run --name {{ anro_ktranslate_instance.name }} --pull={{ anro_ktranslate_instance.pull_policy | default(anro_ktranslate_default_pull_policy) }} --network {{ anro_ktranslate_instance.network | default(anro_ktranslate_default_network) }} --env-file={{ anro_ktranslate_environment_dir }}/{{ anro_ktranslate_instance.name }}.env{% if (anro_ktranslate_instance.network | default(anro_ktranslate_default_network)) != 'host' %}{% for port in anro_ktranslate_instance.ports | default([]) %} --publish={{ port }}{% endfor %}{% endif %}{% for file in anro_ktranslate_instance.files | default([]) %}{% if (file.source | default('managed')) == 'managed' %}{% set mount_source = anro_ktranslate_current_config_dir ~ '/' ~ file.name %}{% else %}{% set mount_source = file.host_path %}{% endif %} --mount={{ ('type=bind,source=' ~ mount_source ~ ',target=' ~ file.destination ~ (',readonly' if (file.read_only | default(true) | bool) else '')) | to_json }}{% endfor %}{% for volume in anro_ktranslate_instance.volumes | default([]) %} --mount={{ ('type=bind,source=' ~ volume.source ~ ',target=' ~ volume.target ~ (',readonly' if (volume.read_only | default(false) | bool) else '')) | to_json }}{% endfor %}{% for capability in anro_ktranslate_instance.cap_add | default([]) %} --cap-add={{ capability }}{% endfor %}{% for docker_arg in anro_ktranslate_instance.extra_docker_args | default([]) %} {{ docker_arg | to_json }}{% endfor %} {{ (anro_ktranslate_instance.image | default(anro_ktranslate_image)) | to_json }}{% for command_arg in anro_ktranslate_instance.command | default(anro_ktranslate_default_command) %} {{ command_arg | to_json }}{% endfor %}

ExecStop={{ anro_ktranslate_docker_binary }} stop --time={{ anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) }} {{ anro_ktranslate_instance.name }}
ExecStopPost=-{{ anro_ktranslate_docker_binary }} rm --force {{ anro_ktranslate_instance.name }}

[Install]
WantedBy=multi-user.target
