# {{ anro_ktranslate_managed_marker }}
# Instance type is descriptive metadata; untyped instances intentionally bypass profile defaults.
# Instance type: {{ anro_ktranslate_instance.type | default('untyped', true) }}
{% for external_stat in anro_ktranslate_external_file_stats.results | default([]) %}
{% if not (external_stat.skipped | default(false) | bool) and (external_stat.item.reload | default('restart')) == 'restart' %}
# Restart-bound external file checksum {{ external_stat.item.host_path }}: {{ external_stat.stat.checksum | default('unavailable') }}
{% endif %}
{% endfor %}
[Unit]
Description=ktranslate {{ anro_ktranslate_instance.type | default('untyped', true) }} instance {{ anro_ktranslate_instance.name }}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec={{ anro_ktranslate_instance.start_limit_interval_sec | default(anro_ktranslate_default_start_limit_interval_sec) }}
StartLimitBurst={{ anro_ktranslate_instance.start_limit_burst | default(anro_ktranslate_default_start_limit_burst) }}

[Service]
{% if (anro_ktranslate_instance.lifecycle.mode | default('persistent')) == 'persistent' %}
Type=simple
Restart=always
{% else %}
Type=oneshot
RemainAfterExit=no
Restart=no
TimeoutStartSec={{ anro_ktranslate_instance.lifecycle.timeout_start_sec | default(1800) | int + 30 }}
{% endif %}
RestartSec={{ anro_ktranslate_instance.restart_sec | default(anro_ktranslate_default_restart_sec) }}
TimeoutStopSec={{ (anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) | int) + 10 }}

# Podman runs in the foreground under systemd; no podman.service dependency.
# A previous unclean shutdown can leave a stopped container with the same name.
# The leading '-' makes an already absent container non-fatal.
ExecStartPre=-{{ anro_ktranslate_podman_binary }} rm --force {{ anro_ktranslate_instance.name }}

{% if (anro_ktranslate_instance.lifecycle.mode | default('persistent')) == 'persistent' %}
ExecStart={% include 'ktranslate.run.j2' %}
{% else %}
# The launcher requires both a discovery completion marker and a fresh output.
ExecStart={{ anro_ktranslate_config_dir }}/{{ anro_ktranslate_instance.name }}/discovery-run.sh
{% endif %}

ExecStop={{ anro_ktranslate_podman_binary }} stop --time={{ anro_ktranslate_instance.stop_timeout | default(anro_ktranslate_default_stop_timeout) }} {{ anro_ktranslate_instance.name }}
ExecStopPost=-{{ anro_ktranslate_podman_binary }} rm --force {{ anro_ktranslate_instance.name }}

[Install]
{% if (anro_ktranslate_instance.lifecycle.mode | default("persistent")) != "timer" %}
WantedBy=multi-user.target
{% endif %}
